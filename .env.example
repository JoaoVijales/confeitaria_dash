# =============================================================================
# Confeitaria Dashboard — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# https://supabase.com/dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<secret-key>

# -----------------------------------------------------------------------------
# Firebase — Client (exposto ao browser)
# https://console.firebase.google.com → Project settings → General → Your apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_MEASUREMENT_ID=
# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-side only)
# https://console.firebase.google.com → Project settings → Service accounts
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project-id>.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ATENÇÃO: manter as quebras de linha como \n literais dentro das aspas

# -----------------------------------------------------------------------------
# AbacatePay
# https://app.abacatepay.com → Configurações → API
# -----------------------------------------------------------------------------
ABACATEPAY_API_KEY=

# IDs dos produtos com cycle=MONTHLY criados no AbacatePay
# AbacatePay Dashboard → Produtos → copie o ID gerado
ABACATEPAY_PRODUCT_ID_BASIC=   # Plano Básico  — R$ 9,90/mês  — 10 produtos
ABACATEPAY_PRODUCT_ID_PRO=     # Plano Pro     — R$ 49,90/mês — 50 produtos
ABACATEPAY_PRODUCT_ID_MAX=     # Plano Max     — R$ 99,90/mês — ilimitado

# Secret do webhook — definido ao criar o webhook no AbacatePay
ABACATEPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Axiom — Monitoramento (requests, funções, Web Vitals)
# https://app.axiom.co → Settings → API Tokens
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AXIOM_DATASET=    # Nome do dataset criado no Axiom
NEXT_PUBLIC_AXIOM_TOKEN=      # API token com permissão de ingest para o dataset

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
